SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ticket_reservation
DB_SSLMODE=disable
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRY_HOURS=24

# Verify that the email domain has an MX or address DNS record.
EMAIL_DOMAIN_CHECK=true
EMAIL_DNS_TIMEOUT_SECONDS=4

# Registration only accepts addresses ending in exactly @gmail.com.
