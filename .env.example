APP_ENV=development
DB_USER=postgres
DB_PASSWORD=replace-with-a-random-database-password
DB_NAME=ticket_reservation
DB_SSLMODE=disable
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRY_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
EMAIL_DOMAIN_CHECK=true
EMAIL_DNS_TIMEOUT_SECONDS=4

# Optional local demo bootstrap. Never enable this in production.
DEMO_MODE=false
DEMO_ADMIN_STUDENT_ID=4000000001
DEMO_ADMIN_EMAIL=ticket.reservation.demo+system-admin@gmail.com
DEMO_ADMIN_PASSWORD=replace-with-a-strong-demo-password
DEMO_DATA_PASSWORD=replace-with-a-strong-dataset-password
